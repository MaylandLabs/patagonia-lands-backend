PORT=6789

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=patagonia_lands
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_jwt_secret_change_this
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# SMTP (for publish request notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
NOTIFICATION_EMAIL=admin@patagonialands.com

# Default Admin
ADMIN_EMAIL=admin@patagonialands.com
ADMIN_PASSWORD=change_this_password
